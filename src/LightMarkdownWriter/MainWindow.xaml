<ui:FluentWindow x:Class="LightMarkdownWriter.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
                 xmlns:vm="clr-namespace:LightMarkdownWriter.ViewModels"
                 xmlns:views="clr-namespace:LightMarkdownWriter.Views"
                 xmlns:conv="clr-namespace:LightMarkdownWriter.Converters"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
                 Title="{Binding WindowTitle}"
                 Icon="pack://application:,,,/Assets/app.ico"
                 Width="1200" Height="760" MinWidth="560" MinHeight="320"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <Window.Resources>
        <conv:EnumEqualsConverter x:Key="EnumEquals" />
        <conv:HeadingIndentConverter x:Key="HeadingIndent" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Alt" Command="{Binding SaveAllCommand}" />
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseTabCommand}" />
        <KeyBinding Key="T" Modifiers="Control+Shift" Command="{Binding ReopenClosedTabCommand}" />
        <KeyBinding Key="F4" Modifiers="Control" Command="{Binding CloseTabCommand}" />
        <KeyBinding Key="Tab" Modifiers="Control" Command="{Binding NextTabCommand}" />
        <KeyBinding Key="Tab" Modifiers="Control+Shift" Command="{Binding PreviousTabCommand}" />
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static vm:ViewMode.Editor}" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static vm:ViewMode.Split}" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static vm:ViewMode.Preview}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding WindowTitle}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Command bar -->
        <Grid Grid.Row="1" Margin="8,0,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.Resources>
                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                    <Setter Property="Appearance" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="8,6" />
                    <Setter Property="Margin" Value="0,0,2,0" />
                </Style>
            </Grid.Resources>

            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                <ui:Button Icon="{ui:SymbolIcon DocumentAdd24}" Content="New" Command="{Binding NewCommand}" ToolTip="New (Ctrl+N)" />
                <ui:Button Icon="{ui:SymbolIcon FolderOpen24}" Content="Open" Command="{Binding OpenCommand}" ToolTip="Open (Ctrl+O)" />
                <!-- Recent files: the menu is built when opened (only files that still exist). -->
                <ui:Button x:Name="RecentButton" Icon="{ui:SymbolIcon History24}" ToolTip="Recent files and closed tabs" AutomationProperties.Name="Recent files"
                           Click="OnRecentClick" Margin="-2,0,2,0">
                    <ui:Button.ContextMenu>
                        <ContextMenu />
                    </ui:Button.ContextMenu>
                </ui:Button>
                <ui:Button Icon="{ui:SymbolIcon Save24}" Content="Save" Command="{Binding SaveCommand}" ToolTip="Save (Ctrl+S)" />
                <ui:Button Icon="{ui:SymbolIcon SaveEdit24}" Content="Save as" Command="{Binding SaveAsCommand}" ToolTip="Save as (Ctrl+Shift+S)" />
                <ui:Button x:Name="ExportButton" Icon="{ui:SymbolIcon ArrowExportLtr24}" Content="Export"
                           ToolTip="Export as HTML or PDF, or copy as HTML" Click="OnExportClick">
                    <ui:Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Export as HTML…" InputGestureText="Ctrl+Shift+E" Click="OnExportHtmlClick">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="Code24" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Export as PDF…" InputGestureText="Ctrl+P" Click="OnExportPdfClick">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="DocumentPdf24" /></MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Copy as HTML" InputGestureText="Ctrl+Shift+C" Click="OnCopyHtmlClick">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="Copy24" /></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </ui:Button.ContextMenu>
                </ui:Button>

                <Rectangle Width="1" Margin="8,6" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />

                <!-- Formatting acts on the editor, so these are handled in code-behind. -->
                <ui:Button Icon="{ui:SymbolIcon TextBold20}" ToolTip="Bold (Ctrl+B)" AutomationProperties.Name="Bold" Click="OnBoldClick" />
                <ui:Button Icon="{ui:SymbolIcon TextItalic20}" ToolTip="Italic (Ctrl+I)" AutomationProperties.Name="Italic" Click="OnItalicClick" />
                <ui:Button Icon="{ui:SymbolIcon Code20}" ToolTip="Inline code (Ctrl+E)" AutomationProperties.Name="Inline code" Click="OnInlineCodeClick" />
                <ui:Button Icon="{ui:SymbolIcon Link20}" ToolTip="Link (Ctrl+K)" AutomationProperties.Name="Link" Click="OnLinkClick" />
                <ui:Button Icon="{ui:SymbolIcon CodeBlock20}" ToolTip="Code block (Ctrl+Shift+K)" AutomationProperties.Name="Code block" Click="OnCodeBlockClick" />
                <ui:Button Icon="{ui:SymbolIcon Table20}" ToolTip="Table: format the table at the caret, or insert one (Ctrl+Shift+F). Add a row: Ctrl+Shift+Enter"
                           Click="OnTableClick" AutomationProperties.Name="Table" />
                <ui:Button Icon="{ui:SymbolIcon Search20}" ToolTip="Find (Ctrl+F) / Replace (Ctrl+H)" AutomationProperties.Name="Find" Click="OnFindClick" />
            </StackPanel>

            <!-- Export result. Lives in the command bar rather than as a toast over the content, because the
                 preview is a native window that would cover anything drawn on top of it. -->
            <StackPanel x:Name="StatusPanel" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left"
                        Margin="16,0,8,0" VerticalAlignment="Center" Visibility="Collapsed">
                <ui:SymbolIcon Symbol="CheckmarkCircle24" Filled="True" FontSize="16" VerticalAlignment="Center"
                               Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                <TextBlock x:Name="StatusText" Margin="6,0,0,0" VerticalAlignment="Center" />
                <ui:Button x:Name="StatusOpenButton" Content="Open" Margin="8,0,0,0" Padding="8,2"
                           Click="OnStatusOpenClick" />
            </StackPanel>

            <!-- Go to line (Ctrl+G): in the command bar, never over the preview. -->
            <StackPanel x:Name="GoToPanel" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left"
                        Margin="16,0,8,0" VerticalAlignment="Center" Visibility="Collapsed">
                <ui:TextBox x:Name="GoToBox" Width="220" ClearButtonEnabled="False"
                            PreviewKeyDown="OnGoToKeyDown" LostKeyboardFocus="OnGoToLostFocus"
                            AutomationProperties.Name="Go to line" />
            </StackPanel>

            <!-- View mode: a segmented control built from RadioButtons styled as toggle buttons. -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <StackPanel.Resources>
                    <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                        <Setter Property="GroupName" Value="ViewMode" />
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="Margin" Value="2,0,0,0" />
                    </Style>
                </StackPanel.Resources>
                <!-- Shown only when GitHub has a newer release (13.3). Opens the download page; nothing installs itself. -->
                <ui:Button x:Name="UpdateButton" Icon="{ui:SymbolIcon ArrowDownload24}" Appearance="Secondary"
                           Padding="10,4" Margin="0,0,8,0" Visibility="Collapsed" Click="OnUpdateClick"
                           ToolTip="Open the download page for the new version" AutomationProperties.Name="Update available" />
                <ui:Button x:Name="OutlineButton" Icon="{ui:SymbolIcon TextBulletListTree24}" ToolTip="Outline (Ctrl+Shift+O)"
                           Click="OnOutlineToggleClick" AutomationProperties.Name="Toggle outline"
                           Appearance="Transparent" BorderThickness="0" Padding="8,6" Margin="0,0,2,0" />
                <ui:Button Icon="{ui:SymbolIcon Settings24}" ToolTip="Settings (Ctrl+,)" AutomationProperties.Name="Settings" Click="OnSettingsClick"
                           Appearance="Transparent" BorderThickness="0" Padding="8,6" Margin="0,0,6,0" />
                <RadioButton ToolTip="Editor only (Ctrl+1)" AutomationProperties.Name="Editor only"
                             IsChecked="{Binding ViewMode, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:ViewMode.Editor}}">
                    <ui:SymbolIcon Symbol="DocumentEdit20" />
                </RadioButton>
                <RadioButton ToolTip="Split (Ctrl+2)" AutomationProperties.Name="Split view"
                             IsChecked="{Binding ViewMode, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:ViewMode.Split}}">
                    <ui:SymbolIcon Symbol="SplitVertical20" />
                </RadioButton>
                <RadioButton ToolTip="Preview only (Ctrl+3)" AutomationProperties.Name="Preview only"
                             IsChecked="{Binding ViewMode, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:ViewMode.Preview}}">
                    <ui:SymbolIcon Symbol="BookOpen20" />
                </RadioButton>
            </StackPanel>
        </Grid>

        <!-- Tab strip only: the editor and preview below are shared by all tabs. -->
        <TabControl x:Name="TabStrip" Grid.Row="2" Margin="8,0,8,0"
                    ItemsSource="{Binding Documents}"
                    SelectedItem="{Binding ActiveDocument, Mode=TwoWay}"
                    PreviewMouseLeftButtonDown="OnTabStripMouseDown" PreviewMouseMove="OnTabStripMouseMove"
                    PreviewMouseLeftButtonUp="OnTabStripMouseUp">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" IsItemsHost="True" />
                    </ScrollViewer>
                </ControlTemplate>
            </TabControl.Template>
            <TabControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:DocumentViewModel}">
                    <StackPanel Orientation="Horizontal" ToolTip="{Binding FilePath}" Background="Transparent">
                        <StackPanel.ContextMenu>
                            <ContextMenu Opened="OnTabMenuOpened">
                                <MenuItem Header="Close" InputGestureText="Ctrl+W"
                                          Command="{Binding PlacementTarget.Tag.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}" />
                                <MenuItem Header="Close others"
                                          Command="{Binding PlacementTarget.Tag.CloseOthersCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}" />
                                <MenuItem Header="Close to the right"
                                          Command="{Binding PlacementTarget.Tag.CloseToTheRightCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}" />
                                <Separator />
                                <MenuItem Header="Save all" InputGestureText="Ctrl+Alt+S"
                                          Command="{Binding PlacementTarget.Tag.SaveAllCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem x:Name="CopyPathItem" Header="Copy path" Click="OnCopyPathClick" />
                                <MenuItem x:Name="RevealItem" Header="Reveal in File Explorer" Click="OnRevealClick" />
                            </ContextMenu>
                        </StackPanel.ContextMenu>
                        <StackPanel.Tag>
                            <!-- The context menu lives outside the visual tree; it reaches the window's view model through this. -->
                            <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}" />
                        </StackPanel.Tag>
                        <StackPanel.InputBindings>
                            <MouseBinding Gesture="MiddleClick"
                                          Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                          CommandParameter="{Binding}" />
                        </StackPanel.InputBindings>
                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                        <Ellipse Width="6" Height="6" Margin="6,0,0,0" VerticalAlignment="Center"
                                 Fill="{DynamicResource TextFillColorSecondaryBrush}"
                                 Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button Margin="6,0,-4,0" Padding="4" MinWidth="0" MinHeight="0"
                                   Appearance="Transparent" BorderThickness="0"
                                   Icon="{ui:SymbolIcon Dismiss16}"
                                   ToolTip="Close (Ctrl+W)" AutomationProperties.Name="{Binding DisplayName, StringFormat='Close {0}'}"
                                   Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                   CommandParameter="{Binding}" />
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
        </TabControl>

        <!-- Shown when the active file changed on disk while it had unsaved edits, or was deleted.
             Hand-built in the Windows 11 InfoBar style: WPF-UI's InfoBar doesn't render custom Content (buttons). -->
        <Border Grid.Row="3" Margin="8,4,8,0" Padding="12,8" CornerRadius="6" BorderThickness="1"
                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Visibility="{Binding ActiveDocument.HasExternalChange, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
            <DockPanel LastChildFill="False">
                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Warning20" Filled="True" FontSize="18"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Left" Margin="12,0,8,0" VerticalAlignment="Center" TextWrapping="Wrap">
                    <Run Text="File changed on disk" FontWeight="SemiBold" />
                    <Run Text="  " />
                    <Run Text="{Binding ActiveDocument.ExternalChangeMessage, Mode=OneWay}" />
                </TextBlock>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="Reload from disk" Margin="8,0,0,0" Appearance="Primary"
                               Command="{Binding ReloadFromDiskCommand}"
                               Visibility="{Binding ActiveDocument.IsModifiedOnDisk, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                    <ui:Button Content="Keep my version" Margin="8,0,0,0"
                               Command="{Binding KeepMyVersionCommand}" />
                    <ui:Button Content="Close tab" Margin="8,0,0,0"
                               Command="{Binding CloseTabCommand}"
                               Visibility="{Binding ActiveDocument.IsDeletedOnDisk, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Outline | editor | splitter | preview -->
        <Grid Grid.Row="4" Margin="8,4,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OutlineColumn" Width="Auto" />
                <ColumnDefinition x:Name="EditorColumn" Width="*" />
                <ColumnDefinition x:Name="SplitterColumn" Width="Auto" />
                <ColumnDefinition x:Name="PreviewColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Heading outline (Ctrl+Shift+O): left of the editor, so it never sits over the preview. -->
            <Border x:Name="OutlineCard" Grid.Column="0" Width="230" Margin="0,0,8,0" Visibility="Collapsed"
                    Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Outline" FontWeight="SemiBold" Margin="14,10,14,6" />
                    <TextBlock x:Name="OutlineEmpty" DockPanel.Dock="Top" Margin="14,0,14,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"
                               Text="No headings yet. Lines starting with # appear here." />
                    <ListBox x:Name="OutlineList" Background="Transparent" BorderThickness="0" Padding="4,0,4,8"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonUp="OnOutlineClick" KeyDown="OnOutlineKeyDown"
                             AutomationProperties.Name="Document outline">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="10,4" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" ToolTip="{Binding Text}" TextTrimming="CharacterEllipsis"
                                           Margin="{Binding Level, Converter={StaticResource HeadingIndent}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="1">
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Solid card surfaces (like Windows 11 Notepad); Mica shows around them. The preview page is
                 painted the same color, since the HWND-based WebView2 can't be transparent. -->
            <Border x:Name="EditorCard" Grid.Column="1"
                    Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8">
                <Grid>
                <avalon:TextEditor x:Name="Editor"
                                   Document="{Binding ActiveDocument.Document}"
                                   FontFamily="Cascadia Mono, Consolas"
                                   FontSize="14"
                                   FontWeight="Normal"
                                   TextOptions.TextFormattingMode="Display"
                                   WordWrap="True"
                                   ShowLineNumbers="True"
                                   Padding="8,6"
                                   Background="Transparent"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   LineNumbersForeground="{DynamicResource TextFillColorTertiaryBrush}"
                                   HorizontalScrollBarVisibility="Disabled"
                                   VerticalScrollBarVisibility="Auto" />
                <views:FindReplaceBar x:Name="FindBar" HorizontalAlignment="Right" VerticalAlignment="Top"
                                      Margin="0,8,20,0" />
                </Grid>
            </Border>

            <GridSplitter x:Name="Splitter" Grid.Column="2" Width="8"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          Background="Transparent" Focusable="False" />

            <Border x:Name="PreviewCard" Grid.Column="3"
                    Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="4">
                <!-- Padding keeps the square WebView inside the rounded corners. -->
                <views:PreviewView x:Name="Preview" />
            </Border>
        </Grid>

        <!-- Status bar (Windows 11 Notepad style): position left; words, line endings, encoding right.
             Line endings and encoding are menus that convert the active document. -->
        <Grid Grid.Row="5" Margin="12,2,12,4" TextElement.FontSize="12">
            <Grid.Resources>
                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                    <Setter Property="Appearance" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="8,2" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Margin" Value="4,0,0,0" />
                </Style>
                <Style TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                </Style>
            </Grid.Resources>

            <TextBlock x:Name="CaretStatus" HorizontalAlignment="Left" Text="Ln 1, Col 1" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="WordStatus" Margin="0,0,8,0" />
                <ui:Button x:Name="LineEndingButton" ToolTip="Line endings" AutomationProperties.Name="Line endings" Click="OnStatusMenuClick">
                    <ui:Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Windows (CRLF)" Command="{Binding ConvertLineEndingsCommand}" CommandParameter="CRLF" />
                            <MenuItem Header="Unix (LF)" Command="{Binding ConvertLineEndingsCommand}" CommandParameter="LF" />
                        </ContextMenu>
                    </ui:Button.ContextMenu>
                </ui:Button>
                <ui:Button x:Name="EncodingButton" ToolTip="Encoding used when saving"
                           Content="{Binding ActiveDocument.EncodingLabel, FallbackValue=UTF-8}" Click="OnStatusMenuClick">
                    <ui:Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="UTF-8" Command="{Binding SetEncodingCommand}" CommandParameter="utf-8" />
                            <MenuItem Header="UTF-8 with BOM" Command="{Binding SetEncodingCommand}" CommandParameter="utf-8-bom" />
                        </ContextMenu>
                    </ui:Button.ContextMenu>
                </ui:Button>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
