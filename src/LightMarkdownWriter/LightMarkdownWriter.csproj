<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>LightMarkdownWriter</Product>
    <Description>A light markdown editor with live preview.</Description>
    <Copyright>MIT License</Copyright>
    <!-- English only: skips dozens of localized satellite assemblies from dependencies. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Window / title bar icon (the exe icon comes from ApplicationIcon). -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Preview page + libraries, embedded and served to WebView2 as https://app.local/ (see PreviewAssets). -->
    <EmbeddedResource Include="Assets\Preview\**" LogicalName="Preview/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Editing\Markdown.xshd" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Markdig" Version="1.6.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
