<?xml version="1.0" encoding="utf-8"?>
<!--
  Portable single-file build:  dotnet publish src/LightMarkdownWriter -p:PublishProfile=win-x64
  Output: artifacts/publish/LightMarkdownWriter.exe — one file; needs the .NET 10 Desktop Runtime
  (WebView2 Runtime ships with Windows 11).
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WebView2Loader.dll is native; bundle it too (extracted on first run) so the exe stands alone. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Precompiled code: faster startup for a small app that's opened often. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <!-- Don't copy dependencies' IntelliSense XML files next to the exe. -->
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\publish\</PublishDir>
  </PropertyGroup>
</Project>
