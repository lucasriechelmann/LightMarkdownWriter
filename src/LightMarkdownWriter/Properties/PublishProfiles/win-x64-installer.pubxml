<?xml version="1.0" encoding="utf-8"?>
<!--
  Build for the installer:  dotnet publish src/LightMarkdownWriter -p:PublishProfile=win-x64-installer
  Self-contained (.NET bundled, nothing else to install), single file. Inno Setup packs the output
  (installer/build-installer.ps1 runs both steps).
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Bundled .NET is ~180 MB uncompressed; compression keeps the installed exe small (measured in PLAN.md). -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\installer-publish\</PublishDir>
  </PropertyGroup>
</Project>
