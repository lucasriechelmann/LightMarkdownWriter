<ui:FluentWindow x:Class="LightMarkdownWriter.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:services="clr-namespace:LightMarkdownWriter.Services"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=services:AppSettings}"
                 Title="Settings" Width="640" Height="720" MinWidth="480" MinHeight="400"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round">
    <ui:FluentWindow.Resources>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="CardDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,20,0,8" />
        </Style>
        <Style TargetType="ui:CardControl" BasedOn="{StaticResource {x:Type ui:CardControl}}">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Settings" ShowMinimize="False" ShowMaximize="False" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,0,24,24">
                <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0" />

                <!-- Appearance -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="Appearance" />
                <ui:CardControl Icon="{ui:SymbolIcon DarkTheme24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="App theme" />
                            <TextBlock Style="{StaticResource CardDescription}" Text="Also used by the preview. Exports are always light." />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox MinWidth="160" SelectedIndex="{Binding ThemeIndex}" AutomationProperties.Name="App theme">
                        <ComboBoxItem Content="Use system setting" />
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                    </ComboBox>
                </ui:CardControl>

                <!-- Editor -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="Editor" />
                <ui:CardControl Icon="{ui:SymbolIcon TextFont24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Font" />
                            <TextBlock Style="{StaticResource CardDescription}" Text="Monospaced fonts installed on this PC." />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox x:Name="FontCombo" MinWidth="200" IsEditable="True" AutomationProperties.Name="Font"
                              Text="{Binding FontFamily, UpdateSourceTrigger=LostFocus}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="{Binding}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </ui:CardControl>
                <ui:CardControl Icon="{ui:SymbolIcon NumberSymbol24}">
                    <ui:CardControl.Header>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Font size" VerticalAlignment="Center" />
                    </ui:CardControl.Header>
                    <ui:NumberBox Width="140" AutomationProperties.Name="Font size" Minimum="8" Maximum="40" SmallChange="1" LargeChange="4"
                                  MaxDecimalPlaces="0" Value="{Binding FontSize, UpdateSourceTrigger=PropertyChanged}" />
                </ui:CardControl>
                <ui:CardControl Icon="{ui:SymbolIcon TextWrap24}">
                    <ui:CardControl.Header>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Word wrap" VerticalAlignment="Center" />
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding WordWrap}" AutomationProperties.Name="Word wrap" />
                </ui:CardControl>
                <ui:CardControl Icon="{ui:SymbolIcon DocumentOnePage24}">
                    <ui:CardControl.Header>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Line numbers" VerticalAlignment="Center" />
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding ShowLineNumbers}" AutomationProperties.Name="Line numbers" />
                </ui:CardControl>
                <ui:CardControl Icon="{ui:SymbolIcon BracesVariable24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Close brackets and quotes" />
                            <TextBlock Style="{StaticResource CardDescription}"
                                       Text="Typing ( [ ` or &quot; adds the closing character, and wraps selected text." />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding AutoClosePairs}" AutomationProperties.Name="Close brackets and quotes" />
                </ui:CardControl>

                <!-- Files -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="Files" />
                <ui:CardControl Icon="{ui:SymbolIcon Open24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Open .md files with LightMarkdownWriter" />
                            <TextBlock x:Name="AssociationStatus" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:Button x:Name="RegisterButton" Content="Register" Appearance="Primary" Click="OnRegisterClick" />
                        <ui:Button x:Name="UnregisterButton" Content="Remove" Margin="8,0,0,0" Click="OnUnregisterClick" />
                    </StackPanel>
                </ui:CardControl>
                <ui:CardControl Icon="{ui:SymbolIcon Settings24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Make it the default for .md files" />
                            <TextBlock Style="{StaticResource CardDescription}"
                                       Text="Windows lets only you choose default apps. Register first, then pick LightMarkdownWriter in Settings." />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:Button Content="Open Default apps" Click="OnDefaultAppsClick" />
                </ui:CardControl>

                <!-- Updates -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="Updates" />
                <ui:CardControl Icon="{ui:SymbolIcon ArrowSync24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Check for updates" />
                            <TextBlock Style="{StaticResource CardDescription}"
                                       Text="Once a day, asks GitHub for the latest release and shows a button when there's a new version. Nothing downloads or installs by itself." />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding CheckForUpdates}" AutomationProperties.Name="Check for updates" />
                </ui:CardControl>

                <!-- About -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="About" />
                <ui:CardControl Icon="{ui:SymbolIcon Info24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock x:Name="VersionText" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource CardDescription}"
                                       Text="MIT License · Markdig, AvalonEdit, WPF-UI, WebView2, highlight.js, Mermaid, github-markdown-css" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:HyperlinkButton Content="GitHub" NavigateUri="https://github.com/lucasriechelmann/LightMarkdownWriter" />
                </ui:CardControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
