<UserControl x:Class="LightMarkdownWriter.Views.FindReplaceBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Visibility="Collapsed">
    <UserControl.Resources>
        <Style x:Key="BarButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="OptionToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="8" Padding="4,6,6,6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.22" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ui:Button x:Name="ExpandButton" Grid.RowSpan="2" Style="{StaticResource BarButton}"
                       VerticalAlignment="Top" Margin="0,4,2,0"
                       Icon="{ui:SymbolIcon ChevronRight20}" ToolTip="Toggle replace (Ctrl+H)"
                       Click="OnExpandClick" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:TextBox x:Name="FindBox" Width="230" PlaceholderText="Find" ClearButtonEnabled="False"
                            TextChanged="OnQueryChanged" PreviewKeyDown="OnFindBoxKeyDown" />
                <ToggleButton x:Name="CaseToggle" Style="{StaticResource OptionToggle}" Content="Aa"
                              ToolTip="Match case (Alt+C)" Click="OnQueryChanged" />
                <ToggleButton x:Name="WordToggle" Style="{StaticResource OptionToggle}" Content="ab"
                              ToolTip="Match whole word (Alt+W)" Click="OnQueryChanged" />
                <ToggleButton x:Name="RegexToggle" Style="{StaticResource OptionToggle}" Content=".*"
                              ToolTip="Use regular expression (Alt+R)" Click="OnQueryChanged" />
                <TextBlock x:Name="MatchInfo" MinWidth="78" Margin="8,0,4,0" VerticalAlignment="Center"
                           TextAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="No results" />
                <ui:Button Style="{StaticResource BarButton}" Icon="{ui:SymbolIcon ArrowUp20}"
                           ToolTip="Previous match (Shift+F3)" Click="OnPreviousClick" />
                <ui:Button Style="{StaticResource BarButton}" Icon="{ui:SymbolIcon ArrowDown20}"
                           ToolTip="Next match (F3)" Click="OnNextClick" />
                <ui:Button Style="{StaticResource BarButton}" Icon="{ui:SymbolIcon Dismiss20}"
                           ToolTip="Close (Esc)" Click="OnCloseClick" />
            </StackPanel>

            <StackPanel x:Name="ReplaceRow" Grid.Row="1" Grid.Column="1" Orientation="Horizontal"
                        Margin="0,6,0,0" Visibility="Collapsed">
                <ui:TextBox x:Name="ReplaceBox" Width="230" PlaceholderText="Replace" ClearButtonEnabled="False"
                            PreviewKeyDown="OnReplaceBoxKeyDown" />
                <ui:Button Style="{StaticResource BarButton}" Margin="6,0,0,0" Content="Replace"
                           ToolTip="Replace (Enter)" Click="OnReplaceClick" />
                <ui:Button Style="{StaticResource BarButton}" Content="Replace all"
                           ToolTip="Replace all (Ctrl+Alt+Enter)" Click="OnReplaceAllClick" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
